---
import Base from '../../layouts/Base.astro';
import { fmtDate as fmt, getPosts } from '../../lib/content';

const posts = await getPosts();
---

<Base title="Writing" description="Notes on programme delivery, PMO practice and data.">
  <section class="section first">
    <div class="wrap">
      <div class="section-head">
        <span class="ref">WRT</span>
        <h2>Writing</h2>
      </div>
      <p class="intro">
        Notes on PMO practice, reporting and data. Also available as
        <a href="/rss.xml">RSS</a>, together with the case studies.
      </p>

      {
        posts.length === 0 ? (
          <p class="empty">Nothing published yet.</p>
        ) : (
          <div class="list">
            {posts.map((post) => (
              <a class="post" href={`/writing/${post.id}/`}>
                <span class="mono date">{fmt(post.data.pubDate)}</span>
                <span class="titleblock">
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .empty {
    color: var(--muted);
    max-width: 38rem;
  }

  .list {
    display: flex;
    flex-direction: column;
  }

  .post {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }

  .post:hover h3 {
    color: var(--accent-ink);
  }

  .post p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .date {
    padding-top: 0.3rem;
  }

  @media (max-width: 640px) {
    .post {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
