---
import Base from '../layouts/Base.astro';
import { roles, credentials } from '../data/experience';
---

<Base
  title="Experience"
  description="Career history of Mahe Mishra, NHS programme delivery and data."
>
  <section class="section first">
    <div class="wrap">
      <div class="section-head">
        <span class="ref">EXP</span>
        <h2>Experience</h2>
      </div>

      <div class="register">
        {
          roles.map((r) => (
            <article class="entry">
              <div class="meta">
                <span class="ref">{r.ref}</span>
                <span class="mono period">
                  {r.current && <span class="dot green" aria-hidden="true" />}
                  {r.period}
                </span>
              </div>
              <div class="body">
                <h3>{r.title}</h3>
                <p class="org mono">{r.org}</p>
                <ul>
                  {r.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="ref">EDU</span>
        <h2>Education and credentials</h2>
      </div>
      <div class="register">
        {
          credentials.map((c) => (
            <article class="entry slim">
              <div class="meta">
                <span class="ref">{c.ref}</span>
              </div>
              <div class="body">
                <h3>{c.title}</h3>
                <p class="org mono">
                  {c.org}
                  {c.detail && ` · ${c.detail}`}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .first {
    border-top: 0;
  }

  .register {
    display: flex;
    flex-direction: column;
  }

  .entry {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
  }

  .entry.slim {
    padding: 1.25rem 0;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .period {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .org {
    margin: 0.35rem 0 0.75rem;
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .body ul {
    padding-left: 1.1rem;
    margin: 0;
  }

  .body li {
    margin-bottom: 0.4rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .meta {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }
  }
</style>
